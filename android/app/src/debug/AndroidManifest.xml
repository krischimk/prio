<?xml version="1.0" encoding="utf-8"?>
<!--
  Nur für den Debug-Build.

  Der Emulator läuft standardmäßig gegen den lokalen Mock
  (`http://127.0.0.1:<port>`, siehe AGENTS.md, „Prüfen im Emulator").
  Android verbietet unverschlüsseltes http seit Version 9; die Ausnahme gilt
  hier ausschließlich für die Loopback-Adressen und ausschließlich im
  Debug-Build – der Release-Build sieht diese Datei nicht.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
