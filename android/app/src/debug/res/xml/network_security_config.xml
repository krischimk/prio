<?xml version="1.0" encoding="utf-8"?>
<!--
  Unverschlüsseltes http nur zum Mock auf demselben Rechner.

  Die Web-Oberfläche kommt aus dem App-Paket (`https://localhost`), der Mock
  antwortet über http. Ohne diese Ausnahme blockiert Android die Anfragen.
  Sie gilt für genau die drei Adressen, unter denen der lokale Mock erreichbar
  ist – nicht für das Netz und nicht für das echte Projekt.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Der Mock auf diesem Rechner. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- So sieht der Android-Emulator den Rechner, auf dem er läuft. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
