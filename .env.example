# ---------------------------------------------------------------------------
# prio – Konfiguration für Supabase
# ---------------------------------------------------------------------------
# Diese Datei ist die Vorlage und wird versioniert.
# Für die lokale Entwicklung: kopieren nach `.env` und Werte eintragen.
#
#     cp .env.example .env
#
# `.env` selbst ist über .gitignore ausgeschlossen und darf niemals
# committet werden.
#
# Beide Werte stehen im Supabase-Dashboard unter
#   Project Settings → API
#
# WICHTIG:
#   Hier gehört ausschließlich der "anon public" Key hinein. Er ist für den
#   Browser gedacht; der Zugriffsschutz kommt aus den Row-Level-Security-
#   Policies (supabase/migrations/0002_rls.sql).
#
#   Der "service_role" Key umgeht jede Sicherheitsregel und darf NIEMALS in
#   eine Client-Anwendung oder in dieses Repository gelangen.
#
# Alle Variablen brauchen das Präfix VITE_, damit Vite sie an den Client
# durchreicht.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://<projekt-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
