# ---------------------------------------------------------------------------
# prio – Konfiguration für Supabase
# ---------------------------------------------------------------------------
# Diese Datei ist die Vorlage und wird versioniert.
# Für die lokale Entwicklung: kopieren nach `.env` und Werte eintragen.
#
#     cp .env.example .env
#
# `.env` selbst ist über .gitignore ausgeschlossen und darf niemals
# committet werden.
#
# Beide Werte stehen im Supabase-Dashboard unter
#   Project Settings → API Keys → Tab "Publishable and secret API keys"
#
# WICHTIG:
#   Hier gehört ausschließlich der PUBLISHABLE KEY hinein (`sb_publishable_…`).
#   Er ist für den Browser gedacht; der Zugriffsschutz kommt aus den
#   Row-Level-Security-Policies (supabase/migrations/0002_rls.sql).
#
#   Der SECRET KEY (`sb_secret_…`, früher "service_role") umgeht jede
#   Sicherheitsregel und darf NIEMALS in eine Client-Anwendung oder in dieses
#   Repository gelangen.
#
# Hintergrund: Supabase schafft die alten Keys `anon` und `service_role` bis
# Ende 2026 ab. Der Publishable Key ist der direkte Ersatz für `anon` mit
# identischen Rechten. Der alte Variablenname VITE_SUPABASE_ANON_KEY wird
# weiterhin akzeptiert, damit ältere Installationen funktionieren.
#
# Alle Variablen brauchen das Präfix VITE_, damit Vite sie an den Client
# durchreicht.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://<projekt-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
