{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "module": "esnext", "moduleResolution": "bundler", "verbatimModuleSyntax": true, "noEmit": true,
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true
  },
  "include": ["server", "src/env.d.ts"]
}
